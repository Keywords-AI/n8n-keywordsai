{
	"name": "@keywordsai/n8n-nodes-keywordsai",
	"version": "0.1.11",
	"description": "Respan Gateway and managed prompts for n8n, with native OpenTelemetry integration",
	"license": "MIT",
	"homepage": "https://www.respan.ai",
	"keywords": [
		"n8n-community-node-package",
		"keywordsai",
		"llm",
		"ai",
		"respan"
	],
	"author": {
		"name": "Frank Chen",
		"email": "frank@keywordsai.co"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/respanai/n8n-keywordsai"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test tests/*.test.cjs",
		"integration": "node scripts/run-integration.mjs",
		"start": "node scripts/start-n8n.mjs"
	},
	"files": [
		"dist",
		"credentials",
		"nodes",
		"icons",
		"*.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KeywordsAIApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/KeywordsAi/KeywordsAi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.46.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"n8n": "2.37.7",
		"@respan/instrumentation-n8n": "file:../respan/javascript-sdks/instrumentations/respan-instrumentation-n8n",
		"@respan/respan-sdk": "file:../respan/javascript-sdks/respan-sdk",
		"@respan/tracing": "file:../respan/javascript-sdks/respan-tracing",
		"n8n-workflow": "2.37.2",
		"flatted": "3.4.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=24.0.0 <25"
	}
}
